# ─── Database ────────────────────────────────────────────────────────────
# Neon Postgres connection string. The branch-name in the host segment
# distinguishes prod vs. dev branches.
DATABASE_URL=postgres://user:password@localhost:5432/tfila

# ─── Scraper ─────────────────────────────────────────────────────────────
# Identifier sent on every outbound scrape. Points to the public /bot page
# describing what we do, so shul webmasters can find/contact us.
SCRAPER_USER_AGENT="Tfila-Bot/1.0 (+https://tfila.co/bot; contact:hello@tfila.co)"

# Kill switch — set to "false" to abort any scrape pathway before it starts.
# Default behavior if unset: scraping IS allowed (true).
SCRAPE_ENABLED=true

# ─── Inngest (background jobs) ───────────────────────────────────────────
# Local dev: leave both empty and run `npx inngest-cli@latest dev`.
# Production: set both from Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Sentry (error tracking) ─────────────────────────────────────────────
# Leave empty in dev to skip init. Production: set from Sentry dashboard.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Anthropic API (LLM schema-build for non-ShulCloud sites) ───────────
# Required. Powers all four tiers of the extraction cascade (HTML text,
# JS-rendered HTML text, PDF document, image vision).
ANTHROPIC_API_KEY=

# ─── Browserless (extraction cascade tier 2: JS-rendered HTML) ──────────
# Optional. Without this key, the JS-rendered tier is skipped silently —
# sites whose schedule is injected by client-side JavaScript (e.g.
# anash.ca/daven) will fall back to PDF/Vision tiers or mark unsupported.
# Free tier: 1,000 renders/month at browserless.io.
BROWSERLESS_API_KEY=

# ─── Google APIs (geocoding + reverse-geocoding + Places search) ───────
# Same key powers all three. Required APIs to enable in the GCP project:
#   - Geocoding API           (address ↔ lat/lng, place name reverse)
#   - Places API (New)        (shul name → address fallback)
# Key's "API restrictions" must include BOTH or Places calls return 403
# (API_KEY_SERVICE_BLOCKED). Pricing: covered by Google's $200/mo free
# credit at our scale.
GOOGLE_GEOCODING_API_KEY=

# ─── Admin auth (stateless magic-link) ──────────────────────────────────
# Secret used to sign magic-link tokens AND session cookies. Must be
# ≥32 random chars (e.g. `openssl rand -base64 48`). Rotate carefully —
# rotation invalidates all existing sessions and pending magic links.
AUTH_SECRET=
# Email that's allowed to sign in. Single-admin model. Use a personal
# email you control. Comparison is case-insensitive.
ADMIN_EMAIL=
# Origin used in magic-link URLs. Local dev = http://localhost:3000.
AUTH_URL=http://localhost:3000
# From-address on outgoing transactional mail (magic links, future shul
# breakage notifications). Should match a verified Resend domain in prod.
AUTH_EMAIL_FROM=hello@tfila.co
# Optional. With key: actually send emails via Resend. Without: print
# magic links to the server console (dev fallback — still gives a usable
# link, just not delivered).
RESEND_API_KEY=

# ─── R2 / S3 (raw HTML + LLM I/O archive) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tfila-archive

# ─── GitHub PAT (nightly-version-bump cron) ──────────────────────────────
# Optional. PAT with "Contents: read+write" permission on isckas/tfila.
# Used by lib/inngest/functions/nightly-version-bump.ts to append a new
# version section to CHANGELOG.md at midnight ET each day. Cron no-ops
# (with a console.warn) if unset, so dev / preview environments don't
# need it.
GITHUB_WRITE_TOKEN=

# ─── Postmark Inbound (Phase 2 — email-newsletter source) ────────────────
# App code is shipped; awaiting vendor pick (see IDEAS.md "Email-inbound
# vendor pick"). Set HTTP Basic auth credentials here AND in Postmark's
# inbound stream config — webhook ignores both if either is unset.
# POSTMARK_INBOUND_USERNAME=
# POSTMARK_INBOUND_PASSWORD=
